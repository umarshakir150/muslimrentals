{
  "name": "muslim-rentals-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Local supervisor/worker orchestration layer that runs the Muslim Rentals agents/*.md roles as separate Claude Code worker processes.",
  "type": "module",
  "scripts": {
    "agents:task": "tsx src/cli.ts",
    "agents:task:full": "tsx src/cli.ts --full",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
