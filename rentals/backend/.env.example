# Muslim Rentals — Backend environment variables
#
# Copy this file to `.env` and fill in real values for local development:
#   cp .env.example .env
#
# All placeholder values below are safe examples only — never commit real
# secrets. In production, JWT_SECRET and JWT_REFRESH_SECRET are rejected at
# startup (see src/utils/validateEnv.ts) if they are missing, shorter than
# 32 characters, or contain an obvious placeholder pattern (e.g. "your_",
# "changeme", "example"). Generate real values with something like:
#   openssl rand -base64 48

# ─── Server ────────────────────────────────────────────────────────────────
# Runtime mode. Controls HTTPS/HSTS enforcement, trust-proxy setting, log
# format, stack-trace exposure, and whether validateEnv() hard-fails on bad
# secrets. Does NOT affect CORS allow-list strictness — that's controlled
# by ALLOWED_ORIGINS/FRONTEND_URL below in both dev and prod.
NODE_ENV=development

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (prisma/schema.prisma). Required
# at startup — validateEnv() fails without it.
DATABASE_URL=postgresql://user:password@localhost:5432/muslim_rentals

# ─── JWT secrets ───────────────────────────────────────────────────────────
# Signing secret for short-lived access tokens (src/utils/jwt.ts). Required,
# minimum 32 characters, must not look like a placeholder in production.
# Generate a real value with: openssl rand -base64 48
#
# The placeholder below deliberately contains "changeme" so that
# validateEnv.ts's own placeholder-pattern check (src/utils/validateEnv.ts)
# will hard-fail the server at startup in production if this value is ever
# left unchanged — do not "clean up" this placeholder to remove that word.
JWT_SECRET=changeme_please_generate_a_real_random_32plus_char_secret

# Separate signing secret for refresh tokens, so compromising one token type
# does not compromise the other. Same requirements and placeholder-pattern
# reasoning as JWT_SECRET — keep this value different from JWT_SECRET.
JWT_REFRESH_SECRET=changeme_please_generate_a_different_real_random_32plus_char_secret

# Access token lifetime (jsonwebtoken "expiresIn" format). Defaults to 15m.
JWT_EXPIRES_IN=15m

# Refresh token lifetime (jsonwebtoken "expiresIn" format). Defaults to 7d.
JWT_REFRESH_EXPIRES_IN=7d

# Secret used by cookie-parser to sign/verify cookies (src/index.ts). Set a
# long random value in any environment that relies on signed cookies. Note:
# unlike JWT_SECRET/JWT_REFRESH_SECRET, validateEnv.ts does not currently
# strength-check this value (it only warns if it's missing) — treat this
# placeholder with the same care as the JWT secrets regardless.
COOKIE_SECRET=changeme_please_generate_a_real_random_cookie_signing_secret

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Google OAuth client ID (src/routes/auth.ts) — used to verify the ID token
# the frontend obtains from Google Sign-In. The backend only ever verifies
# tokens; it never exchanges a code, so no client secret is read here.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── AWS S3 / storage ──────────────────────────────────────────────────────
# Credentials and bucket for listing/avatar image uploads (src/routes/uploads.ts).
# All three of AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_BUCKET are
# required for uploads to work (the code asserts them non-null).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEPLACEHOLDER
AWS_SECRET_ACCESS_KEY=example-placeholder-secret-access-key
AWS_S3_BUCKET=muslim-rentals-uploads-dev

# Optional custom S3-compatible endpoint (e.g. Cloudflare R2). Leave unset to
# use real AWS S3. For R2 this is the private API endpoint from your bucket's
# Settings page, shaped like https://<account-id>.r2.cloudflarestorage.com --
# NOT the same host that serves public reads (see S3_PUBLIC_URL_BASE below).
S3_ENDPOINT=

# Required alongside S3_ENDPOINT for any provider whose upload/API endpoint
# is a different host from its public-read URL (true for R2, and most
# S3-compatible providers -- NOT true for real AWS S3, where the default
# endpoint already serves public GETs directly, so leave this unset there).
# The base URL images are actually served from once uploaded -- e.g. R2's
# auto-generated https://pub-<hash>.r2.dev (enable "Public access" on the
# bucket to get this), or a custom domain attached to the bucket. Without
# this set for a custom-endpoint provider, uploads succeed but the stored
# image URL points at the private API endpoint and never loads.
S3_PUBLIC_URL_BASE=

# ─── SMTP / email ──────────────────────────────────────────────────────────
# Outbound transactional email (password reset, welcome email) via
# nodemailer (src/utils/email.ts).
SMTP_HOST=smtp.example.com
# Port to connect on; 465 is treated as an implicit-TLS connection, any other
# value (e.g. 587) uses STARTTLS. Defaults to 587 if unset.
SMTP_PORT=587
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
# "From" address used on outbound emails.
EMAIL_FROM=noreply@muslimrentals.ca

# ─── CORS / frontend origin ────────────────────────────────────────────────
# Canonical frontend URL — used for CORS fallback, Socket.IO CORS, and links
# embedded in outbound emails (password reset, welcome). Required at startup.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of additional allowed CORS origins. Takes precedence
# over FRONTEND_URL for CORS if set. Recommended to set explicitly rather
# than relying on the FRONTEND_URL fallback.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Global limiter window (ms) and max requests per window per IP.
# Defaults: 900000 (15 min) / 100 requests.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth endpoints (login/register/forgot-password) limiter — tighter window to
# resist brute-force/credential-stuffing. Fixed 15-minute window; only the
# max request count is configurable. Defaults to 10.
AUTH_RATE_LIMIT_MAX=10

# Upload endpoints limiter — fixed 1-hour window; only the max request count
# is configurable. Defaults to 20.
UPLOAD_RATE_LIMIT_MAX=20

# ─── Misc / debugging ──────────────────────────────────────────────────────
# When "true" and NODE_ENV=development, logs every Prisma query
# (src/prisma/client.ts). Leave unset/false outside of local debugging.
LOG_QUERIES=false
