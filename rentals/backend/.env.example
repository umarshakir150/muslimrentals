# Muslim Rentals — backend environment variables
# Copy this file to .env for local development and set real values for
# staging/production in your hosting provider's dashboard.

NODE_ENV=development
PORT=4000

# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/muslim_rentals

# JWT secrets — must be at least 32 random characters. Generate with e.g.
# `openssl rand -hex 32`. Never reuse the example values below in production.
JWT_SECRET=replace_with_a_random_32+_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_32+_character_secret

# URL of the deployed frontend — used for CORS and links in emails.
FRONTEND_URL=http://localhost:3000

# ─── Recommended ───────────────────────────────────────────────────────────
# Comma-separated list of additional allowed CORS origins (optional; defaults
# to FRONTEND_URL alone).
ALLOWED_ORIGINS=http://localhost:3000

# Secret used to sign cookies.
COOKIE_SECRET=replace_with_a_random_cookie_secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 / Cloudflare R2 (image uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
S3_ENDPOINT=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Optional tuning ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20
