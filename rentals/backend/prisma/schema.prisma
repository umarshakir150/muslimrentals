// Muslim Rentals – Prisma Schema
// PostgreSQL database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String?
  googleId          String?   @unique
  avatarUrl         String?
  // S3/R2 object key for avatarUrl -- only set when the avatar was uploaded
  // through our own /uploads/avatar endpoint (never for a Google-provided
  // avatarUrl, which points at Google's own CDN). Lets account deletion and
  // avatar removal know definitively whether -- and what -- to delete from
  // R2, rather than guessing by parsing the URL.
  avatarKey         String?
  phone             String?
  bio               String?
  role              UserRole  @default(USER)
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  isBanned          Boolean   @default(false)
  banReason         String?
  refreshToken      String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  // Email-change verification (Settings): a new email is never live on
  // `email` until its owner confirms via a token sent to that new address.
  // Kept deliberately separate from resetToken/resetTokenExpiry above --
  // reusing one token field for two different security-sensitive flows
  // (password reset vs. email change) risks one flow's token being usable
  // for the other.
  pendingEmail             String?
  pendingEmailToken        String?
  pendingEmailTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listings          Listing[]
  savedListings     SavedListing[]
  sentMessages      Message[]        @relation("SentMessages")
  conversations     ConversationParticipant[]
  reports           Report[]         @relation("ReportsFiled")
  reportsAgainst    Report[]         @relation("ReportsAgainstUser")
  notifications     Notification[]
  messageRestrictionsImposed  UserMessageRestriction[] @relation("MessageRestrictionsImposed")
  messageRestrictionsReceived UserMessageRestriction[] @relation("MessageRestrictionsProtecting")
  listingRemovalsPerformed    Listing[] @relation("ListingModerationRemovedBy")
  listingRestoresPerformed    Listing[] @relation("ListingModerationRestoredBy")

  @@index([email])
  @@index([googleId])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// A targeted moderation action, narrower than the account-wide `isBanned`
// flag: it stops one specific user from messaging one other specific user
// again (introduced for a report's reportedUser -> reporter direction), not
// their whole account. Rows are never deleted so history survives a
// restrict/unrestrict/re-restrict cycle -- `liftedAt` (nullable) marks
// whether it's currently active; re-restricting the same pair after a lift
// updates the same row (see the admin.ts /restrict handler's upsert)
// instead of creating a duplicate.
model UserMessageRestriction {
  id               String    @id @default(uuid())
  restrictedUserId String
  restrictedUser   User      @relation("MessageRestrictionsImposed", fields: [restrictedUserId], references: [id], onDelete: Cascade)
  protectedUserId  String
  protectedUser    User      @relation("MessageRestrictionsProtecting", fields: [protectedUserId], references: [id], onDelete: Cascade)
  reason           String
  createdAt        DateTime  @default(now())
  liftedAt         DateTime?

  @@unique([restrictedUserId, protectedUserId])
  @@index([protectedUserId])
}

// ─── Listings ─────────────────────────────────────────────────────────────────
model Listing {
  id              String          @id @default(uuid())
  title           String
  description     String
  price           Float
  currency        String          @default("CAD")
  bedrooms        Float
  bathrooms       Int
  audience        ListingAudience
  city            String
  town            String?
  province        String?
  neighbourhood   String?
  address         String?
  // Unit/apartment number, kept fully separate from `address` so geocoding
  // (which resolves the building/street, not a specific unit inside it)
  // never has to parse or depend on it -- see utils/geocode.ts. Private,
  // same as `address`: stripped from every public response alongside it in
  // toPublicListingLocation(), never just hidden in the UI.
  unit            String?
  lat             Float
  lng             Float
  contactInfo     String
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  viewCount       Int             @default(0)
  status          ListingStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  expiresAt       DateTime?

  // Nullable + SetNull (not Cascade): permanent ADMIN account deletion
  // (distinct from the self-service DELETE /users/me, which anonymizes
  // rather than deletes the row) removes the User row outright, and this
  // listing must survive that as historical/moderation record rather than
  // being destroyed by a cascade. `userId: null` means "owner account
  // permanently deleted" -- distinct from every other way a listing can be
  // hidden (REMOVED/BANNED/INACTIVE all leave userId intact).
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  images          ListingImage[]
  amenities       ListingAmenity[]
  savedBy         SavedListing[]
  conversations   Conversation[]
  reports         Report[]

  // Admin/moderator "Remove listing" moderation action (distinct from an
  // owner's own DELETE /listings/:id, from BANNED set by /admin/users/:id/ban,
  // and from REMOVED set by account deletion) -- these fields are the only
  // way to tell those apart, since all of them land on the same `status`
  // value or a status the ban flow also uses. Restore is only ever offered
  // when moderationRemovedAt is set and moderationRestoredAt is not (i.e.
  // "currently in a moderator-removed state, not yet restored") -- mirrors
  // UserMessageRestriction.liftedAt's already-established pattern for a
  // reversible moderation action. A restore does not clear the removedAt/
  // removedBy/reason fields, so who removed it and when stays on record
  // even after the listing is restored; a later re-removal clears
  // moderationRestoredAt/By again so restore-eligibility is re-armed.
  // SetNull (not Cascade) on both moderator relations: the moderator who
  // performed the action might later have their own account deleted, but
  // that must never take this listing's moderation history down with it.
  moderationRemovedAt      DateTime?
  moderationRemovedById    String?
  moderationRemovedBy      User?           @relation("ListingModerationRemovedBy", fields: [moderationRemovedById], references: [id], onDelete: SetNull)
  moderationRemovalReason  String?
  moderationRestoredAt     DateTime?
  moderationRestoredById   String?
  moderationRestoredBy     User?           @relation("ListingModerationRestoredBy", fields: [moderationRestoredById], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([userId])
  @@index([status])
  @@index([lat, lng])
}

enum ListingAudience {
  BROTHERS
  SISTERS
  COUPLES
  FAMILIES
  ALL
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  PENDING
  REMOVED
  // Set only by /admin/users/:id/ban on a listing that was ACTIVE at ban
  // time, and reverted to ACTIVE only by /unban -- never applied to a
  // listing that was already INACTIVE/PENDING/REMOVED, so those stay
  // exactly as they were through a ban/unban cycle. Distinct from REMOVED
  // (a moderator's own, independent decision on one specific listing) so
  // the two don't get confused when a listing accumulates both over time.
  BANNED
}

// ─── Listing Images ───────────────────────────────────────────────────────────
model ListingImage {
  id          String   @id @default(uuid())
  url         String
  key         String   // S3 key for deletion
  alt         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ─── Amenities ────────────────────────────────────────────────────────────────
model ListingAmenity {
  id        String  @id @default(uuid())
  name      String

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, name])
}

// ─── Saved Listings ───────────────────────────────────────────────────────────
model SavedListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

// ─── Conversations ────────────────────────────────────────────────────────────
model Conversation {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nullable + SetNull (not Cascade) -- a listing being permanently deleted
  // by its owner must never destroy the *other* participant's message
  // history along with it (that participant has no say in the listing's
  // deletion). Mirrors Report.listingId's existing pattern below.
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

// ─── Messages ─────────────────────────────────────────────────────────────────
model Message {
  id             String       @id @default(uuid())
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (not Cascade): a permanently-deleted sender's own
  // account is gone, but their messages must survive for the *other*
  // participant's conversation history -- a real row delete must never
  // silently blow holes in it. `senderId: null` reads as "Deleted user" on
  // the client, the same label the self-service delete flow already uses
  // for its anonymized row.
  senderId       String?
  sender         User?        @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  reports        Report[]

  @@index([conversationId])
  @@index([senderId])
}

// ─── Cities ───────────────────────────────────────────────────────────────────
model City {
  id        String  @id @default(uuid())
  name      String
  province  String
  lat       Float?
  lng       Float?
  population Int?

  @@unique([name, province])
  @@index([name])
}

// ─── Neighbourhoods ───────────────────────────────────────────────────────────
// Curated, real-coordinate neighbourhood/district reference data per city --
// mirrors the City table's pattern (prisma/seed.ts). Used to resolve a
// listing's coordinates to something more precise than the city's single
// center point, the same way City already resolves a city to its center.
model Neighbourhood {
  id       String @id @default(uuid())
  name     String
  city     String
  province String
  lat      Float
  lng      Float

  @@unique([city, province, name])
  @@index([city, province])
}

// ─── Reports ──────────────────────────────────────────────────────────────────
model Report {
  id          String           @id @default(uuid())
  reason      String
  description String?
  status      ReportStatus     @default(PENDING)
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  resolution  String?

  // Nullable, defaulted to LISTING so every pre-existing row (all of which
  // were listing reports, the only kind that existed before this column)
  // keeps its correct meaning with zero backfill required.
  targetType  ReportTargetType? @default(LISTING)

  // Nullable + SetNull (not Cascade): a permanently-deleted reporter's own
  // account is gone, but a report they filed against someone else is
  // moderation evidence that has nothing to do with their own deletion --
  // it must survive, not vanish along with them. Mirrors listingId/
  // reportedUserId/messageId's existing SetNull pattern below.
  reporterId  String?
  reporter    User?            @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  listingId   String?
  listing     Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)

  // USER reports: who is being reported. SetNull (not Cascade) so a
  // reported user's own account deletion doesn't erase the report record
  // itself -- mirrors listingId's existing SetNull pattern above.
  reportedUserId String?
  reportedUser   User?         @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  // MESSAGE reports: the reported message, plus a frozen snapshot of its
  // body at report time. Messages are mutable with no edit/delete audit
  // trail, so a live FK lookup later could show a moderator content the
  // sender has since changed or deleted -- messageSnapshot preserves what
  // was actually reported, independent of the message's current state.
  messageId       String?
  message         Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageSnapshot String?

  // messageSnapshot retention (founder-approved policy, 2026-09-02, see
  // ai/decisions.md): retained while a report is open; 90 days after the
  // report reaches RESOLVED/DISMISSED (measured from resolvedAt); then the
  // snapshot text is cleared while the report row itself (status, reason,
  // resolution) is retained. retentionHold pauses that clock for an active
  // investigation, dispute, or legal-preservation need -- set/cleared by an
  // admin/moderator via PATCH /admin/reports/:id. snapshotRedactedAt records
  // when a snapshot was actually cleared, so the redaction job never
  // reprocesses an already-redacted row. All nullable/defaulted -- purely
  // additive, no backfill required.
  retentionHold       Boolean   @default(false)
  retentionHoldReason String?
  snapshotRedactedAt  DateTime?

  @@index([status])
  @@index([targetType])
  @@index([reportedUserId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
