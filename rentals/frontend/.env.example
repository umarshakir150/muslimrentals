# Muslim Rentals — frontend environment variables
# Copy this file to .env.local for local development and fill in real values
# for staging/production in your hosting provider's dashboard (e.g. Netlify).

# Backend API base URL. Accepted with or without a trailing /api/v1.
# Local development (matches backend/README "Quick Start", port 4000):
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.IO server URL (same host as the backend API in this project).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Google OAuth client ID (public). Required only if Google sign-in is enabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
